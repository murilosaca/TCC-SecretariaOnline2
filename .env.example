SPRING_PROFILES_ACTIVE=dev
# Banco IAM deste repo: container so2_postgres_iam na porta 5433.
# docker compose sobe outro Postgres em 5432 — não use para a API SO2.
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5433/secretaria_dev
SPRING_DATASOURCE_USERNAME=secretaria
SPRING_DATASOURCE_PASSWORD=localdev
POSTGRES_PASSWORD=localdev
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174
SERVER_PORT=8080
FRONTEND_BASE_URL=http://localhost:5174
IAM_COOKIE_SECURE=false
# Mobile (frontend-react-native): EXPO_PUBLIC_API_URL. Vazio = emulador 10.0.2.2 / iOS localhost.
IAM_DEV_SEED=true
IAM_DEV_SEED_PASSWORD=TroqueEstaSenha1!
EVENT_DEV_PIN=123456
MAIL_HOST=localhost
MAIL_PORT=1025
MAIL_FROM=so2@localhost
JWT_RSA_PRIVATE_KEY=
JWT_RSA_PUBLIC_KEY=
# Par ED25519 dos certificados (PKCS#8 / X.509 PEM). Vazio = par de desenvolvimento derivado da chave RFC 8410.
CERT_ED25519_PRIVATE_KEY=
CERT_ED25519_PUBLIC_KEY=
# MinIO (dev) / S3-compatível (RNF-POR-03). Credenciais só por env.
STORAGE_ENDPOINT=http://localhost:9000
STORAGE_ACCESS_KEY=minioadmin
STORAGE_SECRET_KEY=minioadmin
STORAGE_BUCKET=so2
STORAGE_REGION=us-east-1
# URL pública que o browser usa nas pré-assinadas (host acessível ao cliente).
STORAGE_PUBLIC_ENDPOINT=http://localhost:9000
STORAGE_MODE=s3
