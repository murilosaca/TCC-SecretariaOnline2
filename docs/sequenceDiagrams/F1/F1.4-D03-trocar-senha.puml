@startuml F1.4-D03-trocar-senha
title F1.4-D03 — Trocar senha + invalidar outras sessões
skinparam sequenceMessageAlign center
skinparam responseMessageBelowArrow true
skinparam maxMessageSize 220
autonumber

actor "Aluno" as Aluno
participant "WebApp" as WebApp
participant "JwtFilter" as Jwt
participant "ChangePasswordUseCase" as UC
database "Postgres" as Postgres

Aluno -> WebApp: senha atual + nova / Salvar
WebApp -> Jwt: PATCH /me/password
Jwt -> UC: execute(...)
UC -> Postgres: SELECT senha_hash
Postgres --> UC: hash

UC -> UC: Argon2id.verify(senhaAtual)

UC -> Postgres: UPDATE senha\ninvalida refresh_token\n(exceto sessão atual)
Postgres --> UC: OK
UC --> WebApp: 200 OK
WebApp --> Aluno: banner success\n"Outras sessões encerradas"

@enduml
