@startuml F5.1-D01-dashboard-secretaria
title F5.1-D01 — Dashboard da secretaria
skinparam sequenceMessageAlign center
skinparam responseMessageBelowArrow true
skinparam maxMessageSize 220
autonumber

actor "Secretaria" as Sec
participant "WebApp" as WebApp
participant "JwtFilter" as Jwt
participant "DashboardBFF" as BFF
database "Postgres" as Postgres

Sec -> WebApp: /inicio
WebApp -> Jwt: GET /bff/dashboard/secretary
Jwt -> BFF: JWT ok
BFF -> Postgres: 4 queries paralelas\n(fila ≤ 10)
Postgres --> BFF: KPIs + fila
note right of BFF
  sla_status no BFF;
  QuickTiles via _links
end note
BFF --> WebApp: 200 + _links
WebApp --> Sec: KPIs e tiles

@enduml
