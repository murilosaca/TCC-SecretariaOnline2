@startuml F5.2-D01-fila-solicitacoes
title F5.2-D01 — Fila de solicitações
skinparam sequenceMessageAlign center
skinparam responseMessageBelowArrow true
skinparam maxMessageSize 220
autonumber

actor "Secretaria" as Sec
participant "WebApp" as WebApp
participant "JwtFilter" as Jwt
participant "RequestController" as Ctrl
database "Postgres" as Postgres

Sec -> WebApp: /solicitacoes
WebApp -> Jwt: GET /requests
Jwt -> Ctrl: JWT ok
Ctrl -> Postgres: SELECT escopo cursos\n+ sla_status
Postgres --> Ctrl: page
Ctrl --> WebApp: 200 + _links
WebApp --> Sec: fila com SLA

@enduml
