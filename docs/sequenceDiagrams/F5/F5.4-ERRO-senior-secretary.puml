@startuml F5.4-ERRO-senior-secretary
title F5.4-ERRO — 403 deliberar sem senior_secretary
skinparam sequenceMessageAlign center
skinparam responseMessageBelowArrow true
skinparam maxMessageSize 220
autonumber

actor "Secretaria" as Sec
participant "WebApp" as WebApp
participant "JwtFilter" as Jwt
participant "RequestController" as Ctrl
database "Postgres" as Postgres

Sec -> WebApp: Deliberar
WebApp -> Jwt: PATCH /requests/{id}/deliberate
Jwt -> Ctrl: JWT ok
Ctrl -> Postgres: requires_capability
Postgres --> Ctrl: senior_secretary
note right of Ctrl
  capability ausente
  → sem mutação
end note
Ctrl --> WebApp: 403
WebApp --> Sec: AlertBanner

@enduml
